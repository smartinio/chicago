{
  "name": "chicago-next",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "imports": {
    "#game/*": "./dist/game/*.js",
    "#server/*": "./dist/server/*.js",
    "#shared/*": "./dist/shared/*.js",
    "#utils/*": "./dist/utils/*.js",
    "#views/*": "./views/*.js",
    "#store": "./store/index.js"
  },
  "engines": {
    "node": "24.12.0"
  },
  "scripts": {
    "ws-dev": "tsx watch server/ws.dev.ts --tsconfig tsconfig.server.json",
    "dev": "NODE_ENV=development concurrently 'next dev' 'pnpm ws-dev'",
    "build:client": "NODE_OPTIONS=\"--max-old-space-size=8192\" next build",
    "build:server": "rm -rf dist && NODE_OPTIONS=\"--max-old-space-size=8192\" tsgo --p tsconfig.server.json",
    "build": "pnpm build:client && pnpm build:server",
    "start": "NODE_ENV=production node dist/server/index.js",
    "test:game": "jest --testEnvironment=node --passWithNoTests --forceExit --testPathPatterns=tests/server/",
    "test:pages": "jest --testEnvironment=jsdom --passWithNoTests --forceExit --testPathPatterns=tests/ui/",
    "test:boot": "BOOT_TEST=1 pnpm start",
    "ts": "tsgo --noEmit",
    "test": "pnpm test:game && pnpm test:pages",
    "lint": "next lint",
    "prepare": "husky"
  },
  "dependencies": {
    "@chakra-ui/react": "^2.8.2",
    "@dnd-kit/core": "^6.0.8",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.0",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@trpc/client": "^11.8.1",
    "@trpc/next": "^11.8.1",
    "@trpc/react-query": "^11.8.1",
    "@trpc/server": "^11.8.1",
    "@typescript/native-preview": "7.0.0-dev.20251225.1",
    "canvas-confetti": "^1.9.2",
    "framer-motion": "^11.0.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "next": "^14.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-no-ssr": "^1.1.0",
    "uuid": "^9.0.1",
    "ws": "^8.16.0",
    "zod": "^3.22.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^16.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jest": "^30.0.0",
    "@types/node": "22.10.3",
    "@types/react": "18.2.73",
    "@types/react-dom": "18.2.23",
    "@types/react-no-ssr": "^1.1.7",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.10",
    "concurrently": "^8.2.2",
    "eslint": "9.15.0",
    "eslint-config-next": "14.1.4",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.29.1",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "jest-mock-random": "^1.1.1",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
